# Atelier — canonical frontend. Both variables below are NEXT_PUBLIC_, which
# means they are BAKED INTO THE BROWSER BUNDLE AT BUILD TIME. Changing either
# one in Vercel does nothing until the project is redeployed — there is no
# runtime read of these values.
#
# ⚠ AND IT MEANS NEITHER MAY EVER HOLD A SECRET. Anything prefixed
# NEXT_PUBLIC_ is shipped to every visitor in plain text. Provider keys belong
# to the engine and to this app's own server routes (/api/generate, /api/tryon),
# never here.

# The engine, as reachable FROM THE USER'S BROWSER — not from the container,
# not from Vercel's build machine. The browser makes the call.
#   local     http://127.0.0.1:8000
#   staging   https://api-staging.<tu-dominio>
NEXT_PUBLIC_ATELIER_API=http://127.0.0.1:8000

# The pilot brand this deployment opens on. `lib/brandPref.js` resolves the
# active brand as: the user's own selection, then this, then NOTHING — the old
# `brands[0]` fallback silently bound writes to whichever tenant the API
# listed first, so an unset value shows an honest empty scope instead.
NEXT_PUBLIC_ATELIER_BRAND=Complot

# ---------------------------------------------------------------------------
# Server-side only — this app's own /api routes spend money on these. Set them
# in Vercel as ordinary variables, NOT NEXT_PUBLIC_, and only once
# `middleware.js` is proven to be refusing anonymous callers: it exempts DEMO
# mode affirmatively, so an engine left in demo mode leaves these routes open
# to anyone who can load the page. Names below are read off app/api/*, not
# guessed.
#
# /api/generate — image generation, one of two providers
# OPENAI_API_KEY=
# ATELIER_OPENAI_API_KEY=          # takes precedence over OPENAI_API_KEY
# ATELIER_OPENAI_BASE_URL=         # e.g. an AI-gateway base
# ATELIER_OPENAI_IMAGE_MODEL=
# GOOGLE_AI_API_KEY=
# ATELIER_IMAGE_MODEL=             # which provider/model the route picks
#
# /api/tryon — FASHN jobs
# FASHN_API_KEY=
